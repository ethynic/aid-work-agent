# 默认：所有文本文件在仓库中以 LF 存储，检出时也使用 LF
* text=auto eol=lf

# 二进制文件：禁止任何换行符/编码转换
*.xlsx binary
*.xls  binary
*.docx binary
*.doc  binary
*.pptx binary
*.ppt  binary
*.pdf  binary
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.otf  binary
*.zip  binary
*.gz   binary

# Windows 脚本：在 Windows 上运行，保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
