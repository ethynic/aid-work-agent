# AID Work Agent 环境变量配置
# 复制此文件为 .env 并填写实际值

# ==================== LLM配置 ====================
# 选择LLM提供者: qwen | zhipu
LLM_PROVIDER=qwen
# API Key，支持逗号拼接的多个key
API_KEYS=your_api_key_here
# API 基础URL（可选，部分提供者需要）
BASE_URL=
# 模型编码（可选，覆盖config.yaml中的默认值）
MODEL_CODE=

# ==================== 企业微信配置 ====================
WECOM_ENABLED=false
WECOM_CORP_ID=your_corp_id_here
WECOM_AGENT_ID=your_agent_id_here
WECOM_SECRET=your_secret_here
WECOM_TOKEN=your_token_here
WECOM_ENCODING_AES_KEY=your_encoding_aes_key_here

# ==================== 钉钉配置 ====================
DINGTALK_ENABLED=false
DINGTALK_APP_KEY=your_dingtalk_app_key
DINGTALK_APP_SECRET=your_dingtalk_app_secret
DINGTALK_TOKEN=your_dingtalk_token
DINGTALK_ENCODING_AES_KEY=your_dingtalk_encoding_aes_key

# ==================== 飞书配置 ====================
FEISHU_ENABLED=false
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_VERIFICATION_TOKEN=your_feishu_verification_token
FEISHU_ENCRYPT_KEY=your_feishu_encrypt_key

# ==================== 邮件工具配置 ====================
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
IMAP_SERVER=imap.example.com
IMAP_PORT=993

# ==================== OCR工具配置 ====================
# 百度 OCR
BAIDU_OCR_API_KEY=your_baidu_ocr_api_key
BAIDU_OCR_SECRET_KEY=your_baidu_ocr_secret_key
# PaddleOCR 文档解析
PADDLEOCR_DOC_PARSING_API_URL=
PADDLEOCR_ACCESS_TOKEN=
# PaddleOCR 请求超时（秒），默认120
PADDLEOCR_DOC_PARSING_TIMEOUT=120

# ==================== 搜索工具配置 ====================
# Tavily 搜索 API Key
TAVILY_API_KEY=
# 百度搜索 API Key（baidu-search skill 使用）
BAIDU_API_KEY=

# ==================== 认证配置 ====================
# 超级管理员 Token
QBTOKEN=your_qbtoken_here
# 超级管理员 Token 哈希
QBTOKEN_HASH=
# 最大并发 Token 数
MAX_CONCURRENT_TOKENS=10
# 密码正则规则（重置密码时校验）
PASSWORD_RULE=^(?=.*[A-Za-z])(?=.*\d).{8,50}$
# 密码规则提示信息
PASSWORD_MSG=长度8-50位，必须有字母+数字
# 登录限流配置（格式:次数/时间窗口，如 5/minute），默认 5/minute
RATE_LIMIT_LOGIN=

# ==================== SaaS 多租户配置 ====================
SAAS_ENABLED=false

# ==================== 演示模式配置 ====================
DEMO_ENABLED=true

# ==================== 短信配置 ====================
# 当前使用的短信通道（如 ZhuTong）
SMS_CHANNEL=ZhuTong
# 助通短信用户名
SMS_USERNAME=your_sms_username
# 助通短信密码
SMS_PASSWORD=your_sms_password
# 短信签名（如"公司名称"）
SMS_SIGNATURE=your_company_name
# 验证码模板ID
SMS_TEMPLATE_YZM=your_template_id
# 短信验证码 bypass 码（用于测试）
QBSMSCODE=

# ==================== 应用配置 ====================
DEBUG=false
# CLI 聊天模式（不启动 Web 服务器）
CLI_MODE=false
# CORS 允许的来源（逗号分隔），留空则使用默认值
CORS_ORIGINS=

# ==================== 数据库配置 ====================
# PostgreSQL (默认): postgresql://user:password@localhost:5432/dbname
# GaussDB/OpenGauss: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aid_work_agent
DATABASE_ECHO=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ==================== Gunicorn 部署配置 ====================
SERVER_PORT=8000
WORKERS=9
WORKER_TIMEOUT=120
LOG_LEVEL=info

# ==================== WhatsApp 消息工具配置 ====================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ==================== EAS 合同核验 Skill 配置 ====================
EAS_API_URL=https://dc.trendzone.com.cn/manage/api/eas_auto_contAttach
SMB_SERVER=192.168.200.10
SMB_SHARE_NAME=AIUpload
SMB_USERNAME=aiupload
SMB_PASSWORD=
SMB_MOUNT_POINT=

# ==================== 合同审批 Skill 配置 ====================
CONTRACT_OA_URL=
CONTRACT_OA_USERNAME=
CONTRACT_OA_PASSWORD=
CONTRACT_OA_HEADLESS=false
CONTRACT_APPROVAL_API_URL=https://dc.trendzone.com.cn/manage/api/trend_eas_approval
