# AID Work Agent 环境变量配置
# 复制此文件为 .env 并填写实际值

# ==================== LLM配置 ====================
# 主 provider：单一写法 qwen | zhipu | deepseek（failover 备用链用 yaml 中 llm.failover.providers）
# 链式写法（推荐）：a/b/c 指定完整优先级链，首段为主 provider，其余依次为备用，覆盖 yaml 中的 failover.providers
#   例：LLM_PROVIDER=deepseek/qwen/zhipu → deepseek 主，故障后依次切 qwen、zhipu
#   各段须为合法 provider 名且不重复。单一 provider 写法 = 不启用 failover，链式写法 = 启用（无独立开关）
#   各 provider 的密钥/模型/地址用独立变量配置（见下方 DEEPSEEK_*/QWEN_*/ZHIPU_*）
LLM_PROVIDER=qwen
# 轻量小模型 LITE_MODEL_CODE（低成本简单任务：日报/复盘/评分/空态摘要），独立于主链路 MODEL_CODE
# 支持两种写法：
#   - "provider/model"（如 "qwen/qwen3.8-flash"）：跨 provider 调用，用该 provider 的 key/base_url
#   - 纯模型名（如 "deepseek-v4-flash"）：用当前主 provider
# 未配置时 fallback 到主模型 model
# LITE_MODEL_CODE=qwen/qwen3.8-flash
# Embedding API Key（独立配置，用于向量化/知识库检索）
# 当 LLM_PROVIDER 设置为不支持 Embedding 的提供者时（如 deepseek），
# 需要单独设置此变量，填写支持 Embedding 的 API Key（如通义千问 DashScope Key）
# EMBEDDING_API_KEY=your_embedding_api_key_here

# DeepSeek 独立配置（主 provider、failover 备用或子智能体指定）
DEEPSEEK_API_KEYS=your_deepseek_api_key_here
# DEEPSEEK_MODEL_CODE=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen 独立配置（主 provider、failover 备用或子智能体指定）
# QWEN_API_KEYS=your_qwen_api_key_here
# QWEN_MODEL_CODE=qwen-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Zhipu 独立配置（主 provider、failover 备用或子智能体指定）
# 默认模型 GLM-5.3-Flash（GLM-5 系列首个原生多模态模型，输入 0.8 / 输出 2.8 元/M tokens）
# ZHIPU_API_KEYS=your_zhipu_api_key_here
# ZHIPU_MODEL_CODE=GLM-5.3-Flash
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Moonshot（Kimi）独立配置（weixin-cli 视觉定位走服务端代理时使用，见 docs/design/weixin/weixin-cli-billing.md）
# MOONSHOT_API_KEYS=your_moonshot_api_key_here
# MOONSHOT_MODEL_CODE=kimi-k3
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ==================== weixin-cli（本机 CLI，非服务端） ====================
# 以下为 weixin-cli 在用户本机的环境变量（不读本文件，仅作登记说明）：
# AID_WEIXIN_SERVER_URL=服务端地址（方案 A 代理模式）
# AID_WEIXIN_ACTIVATION_CODE=一次性激活码（首次调用自动激活换 access_token）
# AID_WEIXIN_KIMI_API_KEY=本机直调 Kimi 的降级开关（仅开发调试用，不计费不入账）

# ==================== 邮件工具配置 ====================
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
IMAP_SERVER=imap.example.com
IMAP_PORT=993

# ==================== OCR工具配置 ====================
# 百度 OCR
BAIDU_OCR_API_KEY=your_baidu_ocr_api_key
BAIDU_OCR_SECRET_KEY=your_baidu_ocr_secret_key
# PaddleOCR 文档解析
PADDLEOCR_DOC_PARSING_API_URL=
PADDLEOCR_ACCESS_TOKEN=
# PaddleOCR 请求超时（秒），默认120
PADDLEOCR_DOC_PARSING_TIMEOUT=120

# ==================== 搜索工具配置 ====================
# Tavily 搜索 API Key
TAVILY_API_KEY=
# Bing 搜索 API Key
BING_API_KEY=your_bing_api_key
# 百度搜索 API Key（baidu-search skill 使用）
BAIDU_API_KEY=

# ==================== 认证配置 ====================
# 超级管理员 Token
QBTOKEN=your_qbtoken_here
# 超级管理员 Token 哈希
QBTOKEN_HASH=
# 最大并发 Token 数
MAX_CONCURRENT_TOKENS=10
# 密码正则规则（重置密码时校验）
PASSWORD_RULE=^(?=.*[A-Za-z])(?=.*\d).{8,50}$
# 密码规则提示信息
PASSWORD_MSG=长度8-50位，必须有字母+数字
# 登录限流配置（格式:次数/时间窗口，如 5/minute），默认 5/minute
RATE_LIMIT_LOGIN=

# ==================== SaaS 多租户配置 ====================
# 租户代码：系统自动为每个租户生成唯一代码（4-8位字母数字），用于通用租户登录入口

# ==================== 短信配置 ====================
# 当前使用的短信通道（如 ZhuTong）
SMS_CHANNEL=ZhuTong
# 助通短信用户名
SMS_USERNAME=your_sms_username
# 助通短信密码
SMS_PASSWORD=your_sms_password
# 短信签名（如"公司名称"）
SMS_SIGNATURE=your_company_name
# 验证码模板ID
SMS_TEMPLATE_YZM=your_template_id
# 短信验证码 bypass 码（用于测试）
QBSMSCODE=

# ==================== 应用配置 ====================
DEBUG=false
# 是否将 ERROR 级别日志写入数据库 log_error 表（true/false，默认 false）
WRITE_LOG_ERROR=false
# CLI 聊天模式（不启动 Web 服务器）
CLI_MODE=false
# 对外可访问的基础 URL，用于构造企业微信等渠道对话的文件下载链接等完整 URL
# 生产环境必须设置为实际域名，如 https://your-domain.com
PUBLIC_BASE_URL=https://agent2.aidingyi.cn

# CORS 允许的来源（逗号分隔），留空则使用默认值
CORS_ORIGINS=

# ==================== 文件上传配置 ====================
# 知识库文件大小限制（单位：MB，默认 50MB）
STORAGE_MAX_KNOWLEDGE_FILE_SIZE=50
# 通用上传文件大小限制（单位：MB，默认 20MB）
STORAGE_MAX_GENERAL_FILE_SIZE=20

# ==================== PPT 工具配置 ====================
# PPT 渲染器：python_pptx（旧稳定路径）| pptxgenjs（Node 渲染器，未就绪时回退或返回明确错误）
PPT_RENDERER=python_pptx
# 是否启用 HTML 转 PPTX 导出：true | false
PPT_ENABLE_HTML_EXPORT=false
# HTML 截图 viewport（默认 1920x1080）
PPT_HTML_VIEWPORT_WIDTH=1920
PPT_HTML_VIEWPORT_HEIGHT=1080
# 截图格式：png | jpeg；JPEG 质量范围 1-100
PPT_HTML_IMAGE_FORMAT=png
PPT_HTML_JPEG_QUALITY=90
# HTML 页面、字体、图片等待超时（毫秒）
PPT_HTML_TIMEOUT_MS=30000
# 是否启用严格 QA：true | false
PPT_QA_STRICT=false

# ==================== Redis 配置 ====================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
REDIS_KEY_PREFIX=aid-local # 多个项目实例共用一个redis实例，依靠key前缀区分

# ==================== 数据库配置 ====================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aid_work_agent
DATABASE_ECHO=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# 追踪库配置（可观测性数据，独立数据库，可选）
# 开发环境：同一 PG 实例不同数据库；生产环境：独立 CVM 实例
# LOGS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aid_work_logs2
# LOGS_DB_POOL_MIN=1
# LOGS_DB_POOL_MAX=3

# ==================== Gunicorn 部署配置 ====================
SERVER_PORT=8000
WORKERS=9
WORKER_TIMEOUT=120
LOG_LEVEL=info

# ==================== WhatsApp 消息工具配置 ====================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ==================== EAS 合同核验 Skill 配置 ====================
EAS_API_URL=https://dc.trendzone.com.cn/manage/api/eas_auto_contAttach
SMB_SERVER=192.168.200.10
SMB_SHARE_NAME=AIUpload
SMB_USERNAME=aiupload
SMB_PASSWORD=
SMB_MOUNT_POINT=

# ==================== 合同审批 Skill 配置 ====================
CONTRACT_OA_URL=
CONTRACT_OA_USERNAME=
CONTRACT_OA_PASSWORD=
CONTRACT_OA_HEADLESS=false
CONTRACT_APPROVAL_API_URL=https://dc.trendzone.com.cn/manage/api/trend_eas_approval

# ==================== 高德地图 ====================
AMAP_API_KEY=

# ==================== 企业微信等待提示配置 ====================
# 是否启用等待提示（true/false）
WECOM_WAITING_INDICATOR_ENABLED=true
# 延迟阈值（秒），超过此时间才发送等待提示
WECOM_WAITING_INDICATOR_DELAY_SECONDS=5
WECOM_RPA_AUDIT_HMAC_KEY=replace-with-a-strong-random-secret

# ==================== 积分计费配置 ====================
# 主业务用量系数（token 成本价 × 此系数 = 积分用量，向上取整），默认 100（10 倍加价）
USAGE_FACTOR=100
# 视频创作用量系数（视频秒数 × 单价 × 此系数 = 积分用量，向上取整），默认 33（3.3 倍加价）
VIDEO_GEN_USAGE_FACTOR=33
