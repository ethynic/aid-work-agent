# AID Work Agent 环境变量配置
# 复制此文件为 .env 并填写实际值

# ==================== LLM配置 ====================
# 选择LLM提供者: qwen | zhipu | deepseek
LLM_PROVIDER=qwen
# 通用 API Key（根据 LLM_PROVIDER 自动应用到对应提供者，支持逗号拼接的多个key）
API_KEYS=your_api_key_here
# API 基础URL（可选，部分提供者需要）
BASE_URL=
# 模型编码（可选，覆盖config.yaml中的默认值）
MODEL_CODE=

# DeepSeek LLM 配置（子智能体按需使用，在 SUBAGENT.md 中通过 llm_provider: deepseek 指定）
DEEPSEEK_API_KEYS=your_deepseek_api_key_here
# DEEPSEEK_MODEL_CODE=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ==================== 邮件工具配置 ====================
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
IMAP_SERVER=imap.example.com
IMAP_PORT=993

# ==================== OCR工具配置 ====================
# 百度 OCR
BAIDU_OCR_API_KEY=your_baidu_ocr_api_key
BAIDU_OCR_SECRET_KEY=your_baidu_ocr_secret_key
# PaddleOCR 文档解析
PADDLEOCR_DOC_PARSING_API_URL=
PADDLEOCR_ACCESS_TOKEN=
# PaddleOCR 请求超时（秒），默认120
PADDLEOCR_DOC_PARSING_TIMEOUT=120

# ==================== 搜索工具配置 ====================
# Tavily 搜索 API Key
TAVILY_API_KEY=
# Bing 搜索 API Key
BING_API_KEY=your_bing_api_key
# 百度搜索 API Key（baidu-search skill 使用）
BAIDU_API_KEY=

# ==================== 认证配置 ====================
# 超级管理员 Token
QBTOKEN=your_qbtoken_here
# 超级管理员 Token 哈希
QBTOKEN_HASH=
# 最大并发 Token 数
MAX_CONCURRENT_TOKENS=10
# 密码正则规则（重置密码时校验）
PASSWORD_RULE=^(?=.*[A-Za-z])(?=.*\d).{8,50}$
# 密码规则提示信息
PASSWORD_MSG=长度8-50位，必须有字母+数字
# 登录限流配置（格式:次数/时间窗口，如 5/minute），默认 5/minute
RATE_LIMIT_LOGIN=

# ==================== SaaS 多租户配置 ====================
SAAS_ENABLED=true
# 租户代码：系统自动为每个租户生成唯一代码（4-8位字母数字），用于通用租户登录入口
# 当 DEMO_ENABLED=false 时，用户可通过租户代码登录到对应租户前台

# ==================== 演示模式配置 ====================
DEMO_ENABLED=true

# ==================== 短信配置 ====================
# 当前使用的短信通道（如 ZhuTong）
SMS_CHANNEL=ZhuTong
# 助通短信用户名
SMS_USERNAME=your_sms_username
# 助通短信密码
SMS_PASSWORD=your_sms_password
# 短信签名（如"公司名称"）
SMS_SIGNATURE=your_company_name
# 验证码模板ID
SMS_TEMPLATE_YZM=your_template_id
# 短信验证码 bypass 码（用于测试）
QBSMSCODE=

# ==================== 应用配置 ====================
DEBUG=false
# CLI 聊天模式（不启动 Web 服务器）
CLI_MODE=false
# CORS 允许的来源（逗号分隔），留空则使用默认值
CORS_ORIGINS=

# ==================== 文件上传配置 ====================
# 知识库文件大小限制（单位：MB，默认 50MB）
STORAGE_MAX_KNOWLEDGE_FILE_SIZE=50
# 通用上传文件大小限制（单位：MB，默认 20MB）
STORAGE_MAX_GENERAL_FILE_SIZE=20

# ==================== Redis 配置 ====================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false

# ==================== 数据库配置 ====================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aid_work_agent
DATABASE_ECHO=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# ==================== Gunicorn 部署配置 ====================
SERVER_PORT=8000
WORKERS=9
WORKER_TIMEOUT=120
LOG_LEVEL=info

# ==================== WhatsApp 消息工具配置 ====================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ==================== EAS 合同核验 Skill 配置 ====================
EAS_API_URL=https://dc.trendzone.com.cn/manage/api/eas_auto_contAttach
SMB_SERVER=192.168.200.10
SMB_SHARE_NAME=AIUpload
SMB_USERNAME=aiupload
SMB_PASSWORD=
SMB_MOUNT_POINT=

# ==================== 合同审批 Skill 配置 ====================
CONTRACT_OA_URL=
CONTRACT_OA_USERNAME=
CONTRACT_OA_PASSWORD=
CONTRACT_OA_HEADLESS=false
CONTRACT_APPROVAL_API_URL=https://dc.trendzone.com.cn/manage/api/trend_eas_approval

# ==================== 高德地图 ====================
AMAP_API_KEY=