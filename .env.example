# AID Work Agent 环境变量配置
# 复制此文件为 .env 并填写实际值
#
# 说明：本文件尽量列全所有可配置环境变量（默认注释掉非必配项），便于目视查找。
# 分两类：
#   1. 应用配置 —— 代码（src/、技能脚本）读取的配置
#   2. 部署旋钮 —— 仅 docker-compose / 部署脚本插值使用，应用代码不读取
# 运行时注入变量（AID_*、AGENT_TOKEN 等）见文末「运行时注入」节，勿手工配置。

# ==================== LLM配置 ====================
# 主 provider：单一写法 qwen | zhipu | deepseek（failover 备用链用 yaml 中 llm.failover.providers）
# 链式写法（推荐）：a/b/c 指定完整优先级链，首段为主 provider，其余依次为备用，覆盖 yaml 中的 failover.providers
#   例：LLM_PROVIDER=deepseek/qwen/zhipu → deepseek 主，故障后依次切 qwen、zhipu
#   各段须为合法 provider 名且不重复。单一 provider 写法 = 不启用 failover，链式写法 = 启用（无独立开关）
#   各 provider 的密钥/模型/地址用独立变量配置（见下方 DEEPSEEK_*/QWEN_*/ZHIPU_*）
LLM_PROVIDER=qwen
# 轻量小模型 LITE_MODEL_CODE（低成本简单任务：日报/复盘/评分/空态摘要），独立于主链路 MODEL_CODE
# 支持两种写法：
#   - "provider/model"（如 "qwen/qwen3.8-flash"）：跨 provider 调用，用该 provider 的 key/base_url
#   - 纯模型名（如 "deepseek-flash"）：用当前主 provider
# 未配置时 fallback 到主模型 model
# LITE_MODEL_CODE=qwen/qwen3.8-flash
# Embedding API Key（独立配置，用于向量化/知识库检索）
# 当 LLM_PROVIDER 设置为不支持 Embedding 的提供者时（如 deepseek），
# 需要单独设置此变量，填写支持 Embedding 的 API Key（如通义千问 DashScope Key）
# EMBEDDING_API_KEY=your_embedding_api_key_here

# DeepSeek 独立配置（主 provider、failover 备用或子智能体指定）
DEEPSEEK_API_KEYS=your_deepseek_api_key_here
# DEEPSEEK_MODEL_CODE=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen 独立配置（主 provider、failover 备用或子智能体指定）
# QWEN_API_KEYS=your_qwen_api_key_here
# QWEN_MODEL_CODE=qwen3.8-flash
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Zhipu 独立配置（主 provider、failover 备用或子智能体指定）
# 默认模型 GLM-5.3-Flash（GLM-5 系列首个原生多模态模型，输入 0.8 / 输出 2.8 元/M tokens）
# ZHIPU_API_KEYS=your_zhipu_api_key_here
# ZHIPU_MODEL_CODE=GLM-5.3-Flash
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Moonshot（Kimi）独立配置（weixin-cli 视觉定位走服务端代理时使用，见 docs/design/weixin/weixin-cli-billing.md）
# MOONSHOT_API_KEYS=your_moonshot_api_key_here
# MOONSHOT_MODEL_CODE=kimi-k3
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ==================== 图像生成 / 视频生成配置 ====================
# 通义万相（DashScope）API Key —— 视频生成（wanx provider）与文生图共用
# WANX_API_KEY=your_wanx_api_key_here
# 文生图（DashScope）模型名
# IMAGE_GEN_MODEL=
# 文生图模式（如 synthesis/high_art 等，随模型版本）
# IMAGE_GEN_MODE=
# 文生图是否启用思考（true/false）
# IMAGE_GEN_ENABLE_THINKING=false
# 图片理解（VL）模型名，覆盖 yaml 默认（qwen-vl 系列，模型名必须实测，见 project_qwen_vl_model_retirement）
# IMAGE_VL_MODEL=
# 视频生成 provider（覆盖 yaml 默认：wanx | minimax）
# VIDEO_GEN_PROVIDER=wanx
# MiniMax 视频生成（备选 provider）
# MINIMAX_API_KEY=your_minimax_api_key_here
# MINIMAX_VIDEO_MODEL_CODE=
# MINIMAX_BASE_URL=

# ==================== weixin-cli（本机 CLI，非服务端） ====================
# 以下为 weixin-cli 在用户本机的环境变量（不读本文件，仅作登记说明）：
# AID_WEIXIN_SERVER_URL=服务端地址（方案 A 代理模式）
# AID_WEIXIN_ACTIVATION_CODE=一次性激活码（首次调用自动激活换 access_token）
# AID_WEIXIN_KIMI_API_KEY=本机直调 Kimi 的降级开关（仅开发调试用，不计费不入账）

# ==================== 邮件工具配置 ====================
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
IMAP_SERVER=imap.example.com
IMAP_PORT=993

# ==================== OCR工具配置 ====================
# 百度 OCR
BAIDU_OCR_API_KEY=your_baidu_ocr_api_key
BAIDU_OCR_SECRET_KEY=your_baidu_ocr_secret_key
# PaddleOCR 文档解析
PADDLEOCR_DOC_PARSING_API_URL=
PADDLEOCR_ACCESS_TOKEN=
# PaddleOCR 请求超时（秒），默认120
PADDLEOCR_DOC_PARSING_TIMEOUT=120

# ==================== 搜索工具配置 ====================
# 搜索 provider（覆盖 yaml tools.search.provider）
# SEARCH_PROVIDER=
# Zhipu 联网搜索引擎（覆盖 yaml，如 search_std / search_pro）
# ZHIPU_SEARCH_ENGINE=
# Tavily 搜索 API Key
TAVILY_API_KEY=
# Bing 搜索 API Key
BING_API_KEY=your_bing_api_key
# 百度搜索 API Key（baidu-search skill 使用）
BAIDU_API_KEY=
# 百度风控代理出口（web-search-pro 技能，逗号分隔多个代理 URL，轮换使用）
# WEBSEARCH_BAIDU_PROXY=

# ==================== 网页抓取（web_fetch）配置 ====================
# 抓取 provider（覆盖 yaml tools.fetch.provider）
# WEB_FETCH_PROVIDER=
# 远程抓取 provider（覆盖 yaml tools.fetch.remote_provider）
# WEB_FETCH_REMOTE_PROVIDER=
# PDF 抓取最大下载体积（MB）
# WEB_FETCH_PDF_MAX_DOWNLOAD_MB=
# 抓取总超时（秒）
# WEB_FETCH_TOTAL_TIMEOUT_SECONDS=

# ==================== 认证与安全配置 ====================
# 超级管理员 Token
QBTOKEN=your_qbtoken_here
# 超级管理员 Token 哈希（QBTOKEN 改哈希方案，新部署一律配哈希不配明文）
QBTOKEN_HASH=
# 最大并发 Token 数
MAX_CONCURRENT_TOKENS=10
# 密码正则规则（重置密码时校验）
PASSWORD_RULE=^(?=.*[A-Za-z])(?=.*\d).{8,50}$
# 密码规则提示信息
PASSWORD_MSG=长度8-50位，必须有字母+数字
# 登录限流配置（格式:次数/时间窗口，如 5/minute），默认 5/minute
RATE_LIMIT_LOGIN=
# 下载票据 HMAC 密钥（download_ticket，5 分钟短期票据；缺省由 DATABASE_URL 派生）
# DOWNLOAD_TICKET_SECRET=
# MCP 服务 API Keys（src/mcp/config.py，逗号分隔）
# MCP_API_KEYS=

# ==================== SaaS 多租户配置 ====================
# 租户代码：系统自动为每个租户生成唯一代码（4-8位字母数字），用于通用租户登录入口
# 私有云部署开关（true=客户自购通道等场景，发信不落租户账）
# PRIVATE_CLOUD=true

# ==================== 短信配置 ====================
# 当前使用的短信通道（ZhuTong / Aliyun / Tencent / ChuanLan）
SMS_CHANNEL=ZhuTong
# 助通短信用户名
SMS_USERNAME=your_sms_username
# 助通短信密码
SMS_PASSWORD=your_sms_password
# 短信签名（如"公司名称"）
SMS_SIGNATURE=your_company_name
# 验证码模板ID
SMS_TEMPLATE_YZM=your_template_id
# 短信验证码 bypass 码（用于测试）
QBSMSCODE=
# 阿里云短信（私有化部署客户指定通道时使用）
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
# 阿里云短信签名名称（审核通过后的签名，如"公司名称"）
SMS_ALIYUN_SIGN_NAME=
# 阿里云验证码模板CODE（如 SMS_123456789）
SMS_ALIYUN_TEMPLATE_YZM=
# 腾讯云短信（v3 API，TC3-HMAC-SHA256 签名，见 src/sms/tencent.py）
SMS_TENCENT_SECRET_ID=
SMS_TENCENT_SECRET_KEY=
# 腾讯云短信控制台应用 ID（SmsSdkAppId，纯数字如 1400000000）
SMS_TENCENT_SDK_APP_ID=
# 腾讯云短信签名名称（审核通过后的签名）
SMS_TENCENT_SIGN_NAME=
# 腾讯云验证码模板ID（纯数字）
SMS_TENCENT_TEMPLATE_YZM=
# 创蓝（253）短信
SMS_253_APP_ID=
SMS_253_APP_SECRET=
SMS_253_TEMPLATE_YZM=

# 阿里云智能语音交互（ASR 语音转文字工具，见 settings.py tools.asr 段）
ALIYUN_ASR_ACCESS_KEY_ID=your_aliyun_ak_here
ALIYUN_ASR_ACCESS_KEY_SECRET=your_aliyun_sk_here
# 智能语音交互项目 AppKey（一句话识别服务）
ALIYUN_ASR_APPKEY=your_asr_appkey_here

# 渠道凭据 Fernet 主密钥历史名（兼容存量部署，优先 APP_SECRET_KEY）
# 未配置时 fallback 到 settings.app.secret_key
RPA_SECRET_KEY=your_strong_random_key_here

# ==================== 应用配置 ====================
# 调试开关（默认 false，仅本地开发用）：true 时全局日志降为 DEBUG 级，
# 且直接 python 启动 uvicorn 时开启代码热重载（生产走 gunicorn 不受影响）
# 参见 src/config/settings.py、src/main.py
DEBUG=false
# 是否将 ERROR 级别日志写入数据库 log_error 表（true/false，默认 false）
WRITE_LOG_ERROR=false
# CLI 聊天模式（不启动 Web 服务器）
CLI_MODE=false
# 仿真环境门控（sim 部署专用，设 1 开启；生产勿配）
# SIMULATION_MODE=1
# 对外可访问的基础 URL，用于构造企业微信等渠道对话的文件下载链接等完整 URL
# 生产环境必须设置为实际域名，如 https://your-domain.com
PUBLIC_BASE_URL=https://agent2.aidingyi.cn

# CORS 允许的来源（逗号分隔），留空则使用默认值
CORS_ORIGINS=

# ==================== Web Push 通知（浏览器推送） ====================
# 是否启用 Web Push
# WEB_PUSH_ENABLED=false
# VAPID 密钥对（生成：npx web-push generate-vapid-keys）
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_KEY_ID=
# WEB_PUSH_VAPID_SUBJECT=mailto:ops@example.com
# 密钥轮换后的旧密钥列表（JSON 数组，用于解密历史订阅）
# WEB_PUSH_VAPID_PREVIOUS_KEYS=[]

# ==================== Desktop Agent（桌面端客户端） ====================
# 是否启用 Desktop Agent（授权票据）
# DESKTOP_AGENT_ENABLED=false
# 授权票据 HMAC 密钥
# DESKTOP_AGENT_AUTHORIZATION_SECRET=
# 允许桌面端远程调用的工具白名单（逗号分隔）
# DESKTOP_AGENT_ALLOWED_REMOTE_TOOLS=

# ==================== 文件上传配置 ====================
# 知识库文件大小限制（单位：MB，默认 50MB）
STORAGE_MAX_KNOWLEDGE_FILE_SIZE=50
# 通用上传文件大小限制（单位：MB，默认 50MB）
STORAGE_MAX_GENERAL_FILE_SIZE=50

# ==================== PPT 工具配置 ====================
# PPT 渲染器：python_pptx（旧稳定路径）| pptxgenjs（Node 渲染器，未就绪时回退或返回明确错误）
PPT_RENDERER=python_pptx
# 是否启用 HTML 转 PPTX 导出：true | false
PPT_ENABLE_HTML_EXPORT=false
# HTML 截图 viewport（默认 1920x1080）
PPT_HTML_VIEWPORT_WIDTH=1920
PPT_HTML_VIEWPORT_HEIGHT=1080
# 截图格式：png | jpeg；JPEG 质量范围 1-100
PPT_HTML_IMAGE_FORMAT=png
PPT_HTML_JPEG_QUALITY=90
# HTML 页面、字体、图片等待超时（毫秒）
PPT_HTML_TIMEOUT_MS=30000
# 是否启用严格 QA：true | false
PPT_QA_STRICT=false

# ==================== Redis 配置 ====================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
REDIS_KEY_PREFIX=aid-local # 多个项目实例共用一个redis实例，依靠key前缀区分
# Redis 夜间巡检（00:30，内存/AOF/连接数/无 TTL 键）：仅生产本地容器实例开启；
# 测试环境为腾讯云托管 Redis（云监控覆盖），保持 false
REDIS_INSPECTION_ENABLED=false

# ==================== 数据库配置 ====================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aid_work_agent
DATABASE_ECHO=false
DB_POOL_MIN=2
DB_POOL_MAX=10
# 连接池健康检查间隔（秒，默认 120，需显著小于 POSTGRES_IDLE_SESSION_TIMEOUT）
# POOL_HEALTH_CHECK_INTERVAL=120
# 跳过 db_update.yaml 增量水位执行（仅运维排障用，如 Runner 更新迁移竞态恢复）
# DB_UPDATE_SKIP=1

# 追踪库配置（可观测性数据，独立数据库，可选）
# 开发环境：同一 PG 实例不同数据库；生产环境：独立 CVM 实例
# LOGS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aid_work_logs2
# LOGS_DB_POOL_MIN=1
# LOGS_DB_POOL_MAX=3

# ==================== Agent Runner（独立执行平面） ====================
# 是否启用 Runner（主 API 调度入口开关）
# AGENT_RUNNER_ENABLED=true
# Runner API 地址（服务间调用；compose 单机走服务名 http://runner-api:8091）
# AGENT_RUNNER_API_URL=http://runner-api:8091
# Runner 服务 ID 与来源（多 Runner 对等注册；sources 逗号分隔，默认 chat）
# AGENT_RUNNER_SERVICE_ID=
# AGENT_RUNNER_SERVICE_SOURCES=chat
# Runner Web 面板
# AGENT_RUNNER_WEB_ENABLED=false
# Runner 服务间凭据（明文恒等比较，主 API 与 runner-api 两侧 .env 同值；不配对时 /runners 查询报 401）
# AGENT_RUNNER_WEB_SERVICE_TOKEN=<43位随机串>
# 槽位并发与看门狗阈值（秒）
# AGENT_RUNNER_SLOT_CONCURRENCY=
# AGENT_RUNNER_WATCHDOG_THRESHOLD=
# 持久任务 sleep 是否启用（true/false）
# AGENT_RUNNER_DURABLE_SLEEP_ENABLED=true
# AGENT_RUNNER_AUTO_LOCAL_RECOVERY_PROVIDERS=boss-recruiting

# ==================== 重工具服务（heavy-tools 容器） ====================
# 派发模式：local（默认，全本地执行）/ remote（heavy_tools 白名单内工具远程派发到重容器）
# HEAVY_TOOLS_MODE=local
# 重工具服务地址（默认 http://heavy-tools:8093；跨机部署改内网 IP）
# HEAVY_TOOLS_URL=http://heavy-tools:8093
# 重容器单副本信号量并发（默认 1，改后需重建 heavy-tools 容器）
# HEAVY_TOOLS_CONCURRENCY=1
# 重容器侧共享 storage 根（路径 allowlist 前缀，默认 /app/storage）
# HEAVY_TOOLS_STORAGE_ROOT=/app/storage
# 重容器侧共享 uploads 根（历史附件路径只读，默认 /app/uploads）
# HEAVY_TOOLS_UPLOADS_ROOT=/app/uploads

# ==================== 系统健康监控 ====================
# 公网出带宽（Mbps，健康页展示用）
# PUBLIC_BANDWIDTH_MBPS=5

# ==================== Gunicorn 部署配置 ====================
SERVER_PORT=8000
WORKERS=9
WORKER_TIMEOUT=120
LOG_LEVEL=info

# ==================== WhatsApp 消息工具配置 ====================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ==================== EAS 合同核验 Skill 配置 ====================
EAS_API_URL=https://dc.trendzone.com.cn/manage/api/eas_auto_contAttach
SMB_SERVER=192.168.200.10
SMB_SHARE_NAME=AIUpload
SMB_USERNAME=aiupload
SMB_PASSWORD=
SMB_MOUNT_POINT=

# ==================== 合同审批 Skill 配置 ====================
CONTRACT_OA_URL=
CONTRACT_OA_USERNAME=
CONTRACT_OA_PASSWORD=
CONTRACT_OA_HEADLESS=false
CONTRACT_APPROVAL_API_URL=https://dc.trendzone.com.cn/manage/api/trend_eas_approval

# ==================== 自动填表 Skill 配置 ====================
# 表单元数据（open_modules 开放模块清单 / module_schema 字段元数据）Redis 缓存有效期（秒）
# 默认 600（10 分钟）；调大减少第三方接口调用，调小让模块/字段变更更快生效
# 两个脚本（load_open_modules.py、load_form_schema.py）共用此配置
FORM_FILLING_CACHE_TTL=600

# ==================== 高德地图 ====================
AMAP_API_KEY=

# ==================== 企业微信等待提示配置 ====================
# 是否启用等待提示（true/false）
WECOM_WAITING_INDICATOR_ENABLED=true
# 延迟阈值（秒），超过此时间才发送等待提示
WECOM_WAITING_INDICATOR_DELAY_SECONDS=5

# ==================== 技能级 LLM/运行覆盖（按需配置） ====================
# travel-quote 技能：LLM provider / 模型覆盖（子智能体环境变量 subagent_env_vars 也可注入）
# SKILL_LLM_PROVIDER=
# SKILL_LLM_MODEL=
# travel-quote 导出临时目录覆盖
# SKILL_TMP_DIR=
# web-search-pro 技能：LLM 覆盖（默认走网关）与缓存目录
# WSP_LLM_API_KEY=
# WSP_LLM_BASE_URL=
# WSP_LLM_MODEL=
# WSP_CACHE_DIR=
# 项目进度管家（project-progress-tracker）analyze.py：独立 LLM（OpenAI 兼容接口）
# PPT_LLM_API_KEY=
# PPT_LLM_BASE_URL=https://api.openai.com/v1
# PPT_LLM_MODEL=gpt-4o-mini
# B2B 获客技能：档案/钩子库文件路径覆盖（默认取技能目录内置文件）
# B2B_PROFILE=
# B2B_HOOK_LIBRARY=
# eas-contract-verify 技能脚本 provider 兜底（优先读 LLM_PROVIDER，一般无需配置）
# LLM_DEFAULT_PROVIDER=

# ==================== 积分计费配置 ====================
# 主业务用量系数（token 成本价 × 此系数 = 积分用量，向上取整），默认 100（10 倍加价）
USAGE_FACTOR=100
# 视频创作用量系数（视频秒数 × 单价 × 此系数 = 积分用量，向上取整），默认 33（3.3 倍加价）
VIDEO_GEN_USAGE_FACTOR=33
# Embedding 用量系数，默认 100
# EMBEDDING_USAGE_FACTOR=100
# ASR 用量系数，默认 100
# ASR_USAGE_FACTOR=100
# 图片生成用量系数，默认 100
# IMAGE_USAGE_FACTOR=100

# ==================== 部署旋钮（仅 docker-compose 插值用，应用代码不读取） ====================
# Runner worker 容器资源与槽位
# AGENT_RUNNER_WORKER_CPUS=
# AGENT_RUNNER_WORKER_MEMORY=
# AGENT_RUNNER_WORKER_SLOTS=
# Runner 数据卷宿主机目录
# AGENT_RUNNER_STORAGE_HOST_DIR=
# AGENT_RUNNER_UPLOADS_HOST_DIR=
# 重工具容器副本数与资源（agent2 固定 1，生产起步 2；replicas=2 时须删 compose container_name）
# HEAVY_TOOLS_REPLICAS=0
# HEAVY_TOOLS_CPUS=
# HEAVY_TOOLS_MEMORY=
# HEAVY_TOOLS_CONTAINER=
# Runner overlay 网络与容器名
# AGENT_RUNNER_API_CONTAINER=
# AGENT_RUNNER_NETWORK=
# 本地开发 compose
# API_PORT=
# AID_LOCAL_API_CONTAINER=
# AID_LOCAL_SOURCE_DIR=
# 仿真环境外部网络名
# SIM_EXTERNAL_NETWORK=
# Postgres 容器（docker-compose.postgres.yml / test-db）
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=aid_work_agent
# POSTGRES_PORT=5432

# ==================== 运行时注入（系统自动注入，勿手工配置） ====================
# skill_executor / Runner worker 每次调用注入的上下文（计费身份 fail-closed 来源）：
#   AID_TENANT_ID / AID_USER_ID / AID_SESSION_ID / AID_SUBAGENT_ID
#   AGENT_TOKEN（http_api 工具凭证，经 ToolExecutionContext 替换，防明文进 LLM 上下文）
#   CURRENT_TENANT_ID / CURRENT_USER_ID（部分技能脚本读取的租户/用户身份）
# Runner worker 内部进程管理：
#   AID_RUNNER_ID / AID_RUNNER_WORKER_ID / AID_RUNNER_EXECUTION_ID / AID_RUNNER_ATTEMPT
#   AID_RUNNER_TOOL_CALL_ID / AID_RUNNER_PARENT_PGID / AID_RUNNER_FAILURE_FILE / AID_RUNNER_PROCESS_FILE
# 动态前缀：AGENT_RUNNER_LIMITS_<工具名大写>（按工具覆盖执行限制）
# 容器/进程内部路径（一般不用改）：
#   AGENT_RUNNER_STORAGE_ROOT / AGENT_RUNNER_RESOURCE_DIR
#   RIPGREP_CONFIG_PATH / PROJECT_ROOT / PYTHONPATH / PYTHONUTF8 / PYTHONIOENCODING
# 平台探测（Windows/显示环境检测，非配置项，勿设置）：
#   APPDATA / LOCALAPPDATA / WINDIR / DISPLAY / WAYLAND_DISPLAY
