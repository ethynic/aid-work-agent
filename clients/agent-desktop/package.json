{
  "name": "aid-agent-desktop",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build:renderer": "npm --prefix ../../frontend run build:desktop",
    "build": "npm run build:renderer && tsc && node scripts/copy-renderer.mjs && node ../../frontend/scripts/verify-desktop-build.mjs dist/renderer",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "start": "npm run build && electron .",
    "package:win:dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-win-dev.ps1",
    "package:win:release": "npm run typecheck && npm test && node scripts/package-win.mjs release",
    "verify:package": "node scripts/verify-package.mjs release"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.0",
    "@types/node": "^24.0.0",
    "electron": "43.1.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
