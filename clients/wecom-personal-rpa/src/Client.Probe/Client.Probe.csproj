<Project Sdk="Microsoft.NET.Sdk">

  <!--
    编码前准入验证探测工具（独立控制台）。

    特性：
      - 不加入 WeComPersonalRpaClient.sln（按需诊断，不属发布产物）。
      - 通过 Client.Automation 的 [assembly: InternalsVisibleTo("Client.Probe")] 复用
        DesktopState / WeComMainWindow / NativeMethods 等内部类型，不重复 P/Invoke。
      - 探测只读：只截图 / 读控件树 / 验证焦点夺取，绝不向企微发送任何键鼠或剪贴板输入。

    单独构建运行（把 ARGS 换成实际参数）：
      powershell -File scripts/run-probe.ps1 ARGS
    或（不走脚本）：
      在 src/Client.Probe 目录执行 dotnet build，再运行 bin/Debug/net8.0-windows/Client.Probe.exe ARGS
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>WeCom.PersonalRpa.Probe</RootNamespace>
    <AssemblyName>Client.Probe</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <!-- 与 Client.Automation 对齐：Windows 桌面 + x64（FlaUI/UIA3、OpenCvSharp.runtime.win 均要求）-->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client.Automation\Client.Automation.csproj" />
    <ProjectReference Include="..\Client.Core\Client.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 直接调用 FlaUI.Core.AutomationElements 遍历控件树（dump UIA tree）-->
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <!-- 直接调用 OpenCvSharp 截屏转 Mat 做模板匹配自测 -->
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
    <!-- GDI+ CopyFromScreen 截屏（二维码区域 / 发送按钮区域 / 模板匹配源图）-->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <!-- probe-report.yaml 序列化 -->
    <PackageReference Include="YamlDotNet" Version="16.1.3" />
  </ItemGroup>

</Project>
