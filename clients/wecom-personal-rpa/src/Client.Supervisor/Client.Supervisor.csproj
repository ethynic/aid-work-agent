<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WeCom.PersonalRpa.Supervisor</RootNamespace>
    <AssemblyName>Client.Supervisor</AssemblyName>
    <!-- Windows Service 监督进程：通过 sc.exe 注册时使用此唯一 GUID -->
    <ProjectGuid>44444444-4444-4444-4444-444444444444</ProjectGuid>
    <OutputType>Exe</OutputType>
    <UseAppHost>true</UseAppHost>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <Company>WeCom.PersonalRpa</Company>
    <Product>WeCom Personal RPA Supervisor</Product>
    <Description>Windows Service 监督进程：周期检查 Client.App 存活，死亡按指数退避拉起，失败超阈值上报离线。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 跨工程引用：AgentApiClient / RequestSigner / IHealthReporter / ClientOptions 定义在 Core -->
    <ProjectReference Include="..\Client.Core\Client.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 通用主机 + Windows Service 支持（protocol.md C.7 锁定版本 8.x） -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <!-- 日志：Serilog + 文件 sink（与 Core 统一技术栈；版本与 Client.Core.csproj 对齐） -->
    <PackageReference Include="Serilog" Version="4.0.2" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.EventLog" Version="4.0.0" />
  </ItemGroup>

</Project>
