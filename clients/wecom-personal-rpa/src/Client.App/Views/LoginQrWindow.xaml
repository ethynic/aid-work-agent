<Window x:Class="WeCom.PersonalRpa.App.Views.LoginQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="企业微信登录" Height="460" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6F7"
        ShowInTaskbar="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="请使用企业微信扫码登录"
                   FontSize="18" FontWeight="SemiBold" Foreground="#1F2329"
                   HorizontalAlignment="Center" Margin="0,0,0,12" />

        <TextBlock Grid.Row="1"
                   x:Name="HintText"
                   Text="等待二维码采集..."
                   FontSize="13" Foreground="#646A73"
                   HorizontalAlignment="Center" Margin="0,0,0,16" />

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Image x:Name="QrImage"
                   Width="240" Height="240"
                   Stretch="Uniform" />
        </Border>

        <Button Grid.Row="3"
                x:Name="RefreshButton"
                Content="刷新二维码"
                Height="36"
                Margin="0,16,0,0"
                Click="RefreshButton_Click"
                Background="#3370FF" Foreground="White"
                BorderThickness="0"
                FontSize="14" />
    </Grid>
</Window>
