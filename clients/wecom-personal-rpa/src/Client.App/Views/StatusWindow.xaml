<Window x:Class="WeCom.PersonalRpa.App.Views.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="客户端状态" Height="420" Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0" x:Name="StatusDot"
                     Width="12" Height="12" Fill="#3370FF"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" x:Name="StatusText"
                       Text="运行中" FontSize="16" FontWeight="SemiBold"
                       Foreground="#1F2329" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="账号：" Foreground="#646A73" Margin="0,0,12,6" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AccountText" Text="—" Foreground="#1F2329" Margin="0,0,0,6" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="客户端：" Foreground="#646A73" Margin="0,0,12,6" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ClientText" Text="—" Foreground="#1F2329" Margin="0,0,0,6" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="运行时长：" Foreground="#646A73" Margin="0,0,12,0" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="UptimeText" Text="—" Foreground="#1F2329" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="最近事件" FontSize="14" FontWeight="SemiBold"
                   Foreground="#1F2329" Margin="0,4,0,8" />

        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12" MinHeight="120">
            <ListView x:Name="EventsList" BorderThickness="0" Background="Transparent" />
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="打开日志目录" Height="34" Padding="16,0" Margin="0,0,8,0"
                    Background="#FFFFFF" Foreground="#1F2329" BorderBrush="#DEE0E3"
                    Click="OpenLogs_Click" />
            <Button Content="关闭" Height="34" Padding="24,0"
                    Background="#3370FF" Foreground="White" BorderThickness="0"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
