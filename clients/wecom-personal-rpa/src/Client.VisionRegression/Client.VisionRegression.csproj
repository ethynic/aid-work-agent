<Project Sdk="Microsoft.NET.Sdk">

  <!--
    真机视觉回归工具（独立控制台，按需诊断，不加入 WeComPersonalRpaClient.sln）。

    用途：
      阶段 3B 任务 E —— 真机端到端跑 Client.Automation 视觉定位流程，
      对比 C# QwenVisionLocator 实现与 Python 原型（probe-qwen-vl-full.py）的输出。

    特性：
      - 不向企微发送任何键鼠 / 剪贴板输入（只读消费 ScreenCapturer + QwenVisionLocator）。
      - 通过 Client.Automation 的 [assembly: InternalsVisibleTo("Client.VisionRegression")]
        复用 ImageEncoder / BboxJsonParser 等内部类型用于诊断标注图。
      - 每个 5 个测试场景独立 try/catch，失败 loud 但不中断其他场景。
      - 生成 YAML 报告 + PNG 标注图。

    构建运行：
      powershell -ExecutionPolicy Bypass -File scripts/run-vision-regression.ps1

    TargetFramework 说明：
      与 Client.VisionProbe 一致，用 net8.0-windows10.0.19041.0 保持 Windows.Media.Ocr 可用性
      （未来扩展降级 OCR 场景时无需改 TFM）。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>WeCom.PersonalRpa.VisionRegression</RootNamespace>
    <AssemblyName>Client.VisionRegression</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>false</UseWinUI>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client.Automation\Client.Automation.csproj" />
    <ProjectReference Include="..\Client.Core\Client.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- GDI+ CopyFromScreen / 标注图 -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
    <!-- YAML 报告序列化 -->
    <PackageReference Include="YamlDotNet" Version="16.1.3" />
    <!-- 日志（与 Client.Automation 一致） -->
    <PackageReference Include="Serilog" Version="4.0.2" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

</Project>
