<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ProjectGuid>22222222-2222-2222-2222-222222222222</ProjectGuid>
    <RootNamespace>WeCom.PersonalRpa.Automation</RootNamespace>
    <AssemblyName>Client.Automation</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <Version>1.0.0</Version>
    <!-- 平台：FlaUI/UIA3、Win32 P/Invoke、OpenCvSharp.runtime.win 均要求 Windows 桌面 -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client.Core\Client.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FlaUI 4.x：UIA3 主驱动，UIA2 作降级（protocol.md §C.7） -->
    <PackageReference Include="FlaUI.Core" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageReference Include="FlaUI.UIA2" Version="4.0.0" />
    <!-- OpenCvSharp 4.x：模板匹配视觉降级（runtime.win 提供原生 DLL） -->
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
    <!-- 节点配置 YAML 解析（wecom_nodes.yaml） -->
    <PackageReference Include="YamlDotNet" Version="16.1.3" />
    <!-- 与 Core 统一日志栈 -->
    <PackageReference Include="Serilog" Version="4.0.2" />
    <!-- System.Drawing.Common：GDI+ 屏幕截图 / 位图（二维码区域截图），net8.0-windows 才支持 -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- assets/wecom_nodes.yaml：节点默认占位常量，随工程输出一起复制 -->
    <None Update="assets\wecom_nodes.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
