{
  "name": "agent-tool-runtime",
  "version": "0.2.14",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "description": "本地工具 Runtime：共用 Host、配对、心跳与云端 invocation 执行",
  "type": "module",
  "scripts": {
    "build": "npm run build:main",
    "build:main": "npm run build:core && tsc -p tsconfig.main.json",
    "typecheck": "npm run build:core && tsc --noEmit -p tsconfig.main.json",
    "test": "npm run build:main && node scripts/run-tests.mjs",
    "cli": "npm run build:main && node dist/src/cli.js",
    "prepack": "npm run build:main && npm install --install-links --ignore-scripts",
    "postpack": "npm install --install-links=false --ignore-scripts",
    "build:core": "npm --prefix ../shared/local-tool-host-core run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3",
    "@aid/local-tool-host-core": "file:../shared/local-tool-host-core"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "aid-runtime": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "bundledDependencies": [
    "@aid/local-tool-host-core"
  ]
}
