{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "agent-turn-next-request.schema.json", "title": "AgentTurnNextRequest",
  "type": "object", "additionalProperties": false,
  "required": ["supported_protocol_versions", "idempotency_key", "correlation", "input"],
  "properties": {
    "supported_protocol_versions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" } },
    "idempotency_key": { "type": "string", "minLength": 8 },
    "correlation": { "$ref": "agent-turn-correlation.schema.json" },
    "input": { "$ref": "agent-turn-input.schema.json" }
  }
}
