{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "remote-tool-gateway.schema.json", "title": "RemoteToolInvokeRequest",
  "type": "object", "additionalProperties": false,
  "required": ["supported_protocol_versions", "idempotency_key", "correlation", "tool_name", "target", "schema_version", "schema_digest", "arguments", "policy_revision", "authorization_ticket"],
  "properties": {
    "supported_protocol_versions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" } }, "idempotency_key": { "type": "string", "minLength": 8 },
    "correlation": { "$ref": "agent-turn-correlation.schema.json" }, "tool_name": { "type": "string", "minLength": 1 }, "target": { "const": "server" },
    "schema_version": { "type": "string", "minLength": 1 }, "schema_digest": { "type": "string", "minLength": 1 }, "arguments": { "type": "object" }, "policy_revision": { "type": "string", "minLength": 1 }, "authorization_ticket": { "type": "string", "minLength": 1 }
  }
}
