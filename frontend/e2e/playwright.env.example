# ==================== Playwright E2E 环境变量示例 ====================
# 把这些变量写入项目根 .env（或导出到 shell），即可启用 E2E 测试。
# 认证快照生成：node e2e/scripts/refresh-auth.mjs

# 前端地址（vite dev，默认 http://localhost:3000，/api 代理到本地容器 :8000）
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# 数据库连接串（缺省读根 .env 的 DATABASE_URL；用于读取登录图形验证码明文）
# PLAYWRIGHT_DATABASE_URL=postgresql://aid_user:xxx@host:5433/aid_work_agent2

# 租户管理员测试账号（token-usage 等租户前台页面需要 tenant_admin 角色）
PLAYWRIGHT_TENANT_ID=tenant_e9b2fab93a2f
PLAYWRIGHT_IDENTIFIER=手机号或用户名
PLAYWRIGHT_PASSWORD=密码

# 平台管理员账号（可选）：生成 platform-admin 认证快照，用于断言
# 积分用量弹窗的 7 个分项列（含「缓存创建输入」）
# PLAYWRIGHT_PLATFORM_IDENTIFIER=平台管理员手机号
# PLAYWRIGHT_PLATFORM_PASSWORD=密码
