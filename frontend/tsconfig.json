{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["web/*"],
      "@web/*": ["web/*"],
      "@desktop/*": ["desktop/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["web/**/*.ts", "web/**/*.tsx", "web/**/*.vue", "desktop/**/*.ts", "desktop/**/*.tsx", "desktop/**/*.vue", "shared/**/*.ts", "shared/**/*.tsx", "shared/**/*.vue"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
