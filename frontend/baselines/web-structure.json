{
  "version": 1,
  "entry": "/web/main.ts",
  "routeSources": ["web/router/agentRoutes.ts", "web/router/portalRoutes.ts"],
  "authGuards": {
    "publicSuffixes": ["/login", "/reset-password"],
    "tenantPrefixes": ["/t/", "/portal"],
    "tenantComposable": "useTenantAuth",
    "defaultComposable": "useDemoAuth"
  },
  "bundleForbiddenModules": ["desktop/", "web/main.desktop.ts", "web/router/desktopRoutes.ts"]
}
