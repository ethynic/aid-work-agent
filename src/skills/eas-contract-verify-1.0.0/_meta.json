{
  "name": "eas-contract-verify",
  "version": "1.1.0",
  "description": "全筑EAS合同核对技能，OCR解析合同扫描件后与EAS系统数据自动比对，支持一键归档自动化审核",
  "author": "aid-work-agent",
  "created_at": "2026-04-02",
  "scripts": [
    "eas_contract_verify.py",
    "parse_contract_pdf.py"
  ],
  "dependencies": [
    "httpx",
    "PyMuPDF"
  ],
  "metadata": {
    "openclaw": {
      "emoji": "🔍",
