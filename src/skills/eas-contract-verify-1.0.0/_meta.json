    { "type": "keyword", "pattern": "合同验证" },
    { "type": "keyword", "pattern": "合同扫描件核对" },
    { "type": "keyword", "pattern": "盖章合同核对" },
    { "type": "keyword", "pattern": "合同归档核对" },
    { "type": "keyword", "pattern": "全筑合同" },
    { "type": "keyword", "pattern": "合同归档审核" },
    { "type": "keyword", "pattern": "合同归档自动化审核" }
  ]
}
