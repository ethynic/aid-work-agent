# 合同审批 OA 系统配置
# 复制此文件为 .env 并填写实际值

# OA 系统登录地址
CONTRACT_OA_URL=http://f.trendzone.com.cn:8089/portal/main.jsp

# OA 系统登录用户名
CONTRACT_OA_USERNAME=your_username_here

# OA 系统登录密码
CONTRACT_OA_PASSWORD=your_password_here

# 是否使用无头模式（true=不显示浏览器，false=显示浏览器）
# 默认 false，调试时可设为 false 观察操作过程
CONTRACT_OA_HEADLESS=false

# EAS 审批 API 地址（可选，默认使用下面地址）
# CONTRACT_APPROVAL_API_URL=https://dc.trendzone.com.cn/manage/api/trend_eas_approval
