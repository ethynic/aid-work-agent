# /etc/systemd/system/web-c-sig-demo.service
# 官网客服签名链接 demo 登录后端（聊易 agent.0635easy.com）
[Unit]
Description=web_c signed-link demo login backend (Liaoyi)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/agent/www_static
ExecStart=/usr/bin/python3 /var/www/agent/www_static/web_c_sig_demo_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
