# ============================================
# AID Work Agent 生产环境配置模板
# ============================================
# 使用说明：
# 1. 复制此文件为 .env: cp .env.production.example .env
# 2. 修改配置项为实际值
# 3. 不要将 .env 文件提交到版本控制

# ========== LLM 配置 ==========
# 必填：选择 LLM 提供商 (qwen | zhipu)
LLM_PROVIDER=qwen

# 通义千问配置
QWEN_API_KEYS=your_qwen_api_key_here

# 智谱GLM配置（备选）
# ZHIPU_API_KEYS=key-xxx111,key-yyy222,key-zzz333

# ========== 服务配置 ==========
# 后端API端口（容器内部端口）
SERVER_PORT=8000

# 容器映射端口（宿主机端口）
API_PORT=8000

# 调试模式（生产环境必须为 false）
DEBUG=false

# ========== 企业微信配置 ==========
# 是否启用企业微信渠道
WECOM_ENABLED=true

# 企业ID
WECOM_CORP_ID=your_corp_id_here

# 应用ID
WECOM_AGENT_ID=your_agent_id_here

# 应用Secret
WECOM_SECRET=your_secret_here

# 回调配置Token
WECOM_TOKEN=your_token_here

# 回调配置EncodingAESKey
WECOM_ENCODING_AES_KEY=your_aes_key_here

# ========== 钉钉配置 ==========
# 是否启用钉钉渠道
DINGTALK_ENABLED=false

# 钉钉应用Key
DINGTALK_APP_KEY=your_app_key_here

# 钉钉应用Secret
DINGTALK_APP_SECRET=your_app_secret_here

# 钉钉回调Token
DINGTALK_TOKEN=your_token_here

# 钉钉回调EncodingAESKey
DINGTALK_ENCODING_AES_KEY=your_aes_key_here

# ========== 飞书配置 ==========
# 是否启用飞书渠道
FEISHU_ENABLED=false

# 飞书应用ID
FEISHU_APP_ID=your_app_id_here

# 飞书应用Secret
FEISHU_APP_SECRET=your_app_secret_here

# 飞书验证Token
FEISHU_VERIFICATION_TOKEN=your_token_here

# 飞书加密Key
FEISHU_ENCRYPT_KEY=your_encrypt_key_here

# ========== 邮件服务配置 ==========
# SMTP服务器地址
SMTP_SERVER=smtp.example.com

# SMTP端口（SSL通常为465，TLS通常为587）
SMTP_PORT=465

# SMTP用户名（通常是邮箱地址）
SMTP_USER=your_email@example.com

# SMTP密码
SMTP_PASSWORD=your_smtp_password_here

# IMAP服务器地址
IMAP_SERVER=imap.example.com

# IMAP端口（SSL通常为993）
IMAP_PORT=993

# ========== 搜索工具配置 ==========
# Tavily API密钥（用于网络搜索）
TAVILY_API_KEY=your_tavily_api_key_here

# ========== OCR 服务配置 ==========
# 百度OCR API密钥
BAIDU_OCR_API_KEY=your_ocr_api_key_here

# 百度OCR Secret密钥
BAIDU_OCR_SECRET_KEY=your_ocr_secret_key_here

# ========== 其他配置 ==========
# 日志级别（DEBUG | INFO | WARNING | ERROR）
LOG_LEVEL=INFO

# 最大文件上传大小（MB）
MAX_UPLOAD_SIZE=100

# 会话超时时间（秒）
SESSION_TIMEOUT=3600

# ========== EAS 合同核对 - SMB 共享目录配置 ==========
# EAS 合同归档 API 地址
EAS_API_URL=https://dc.trendzone.com.cn/manage/api/eas_auto_contAttach

# SMB 服务器地址
SMB_SERVER=192.168.200.10

# SMB 共享名称
SMB_SHARE_NAME=AIUpload

# SMB 访问用户名
SMB_USERNAME=aiupload

# SMB 访问密码
SMB_PASSWORD=your_smb_password_here

# SMB 挂载点路径（仅 Linux/Docker 生产环境使用）
# 宿主机需预先通过 mount.cifs 挂载到此路径
SMB_MOUNT_POINT=/mnt/smb/AIUpload
