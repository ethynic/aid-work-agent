# AID Work Agent 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# cp deploy/.env.example deploy/.env

# ============================================
# 必需配置
# ============================================

# LLM 提供商: qwen | zhipu
LLM_PROVIDER=qwen

# ------------------------------------------------
# 阿里云 Qwen API Key
# ------------------------------------------------
# 可以单个Key，也可以多个Key：
QWEN_API_KEYS=your_qwen_api_key_here

# 生产（多 Key 池，逗号分隔）：
# QWEN_API_KEYS=key-aaa111,key-bbb222,key-ccc333

# ------------------------------------------------
# 智谱 GLM API Key
# ------------------------------------------------
# 可以单个Key，也可以多个Key：
ZHIPU_API_KEYS=your_zhipu_api_key_here

# 生产（多 Key 池，逗号分隔）：
# ZHIPU_API_KEYS=key-xxx111,key-yyy222,key-zzz333

# ============================================
# 应用配置
# ============================================

# 调试模式: true | false
DEBUG=false

# API 服务端口
API_PORT=8000

# Gradio UI 端口
GRADIO_PORT=7860

# ============================================
# 企业微信配置 (可选)
# ============================================
# 设置 WECOM_ENABLED=true 启用

WECOM_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=

# ============================================
# 钉钉配置 (可选)
# ============================================
# 设置 DINGTALK_ENABLED=true 启用

DINGTALK_ENABLED=false
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_TOKEN=
DINGTALK_ENCODING_AES_KEY=

# ============================================
# 飞书配置 (可选)
# ============================================
# 设置 FEISHU_ENABLED=true 启用

FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ============================================
# 邮件工具配置 (可选)
# ============================================

SMTP_SERVER=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
IMAP_SERVER=
IMAP_PORT=993

# ============================================
# 其他工具配置
# ============================================

# Tavily 搜索 API Key
TAVILY_API_KEY=

# 百度 OCR API Key
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
